# ==============================================================================
# MI TIENDA E-COMMERCE - BACKEND ENVIRONMENT CONFIGURATION (PRODUCTION READY)
# ==============================================================================
NODE_ENV=production
PORT=5000
APP_PUBLIC_URL=https://tutienda.com

# Database Connection (Neon / Supabase PostgreSQL Free Tier)
# Use pooled connection string (with PgBouncer) for standard runtime
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/mi_tienda?sslmode=require
# Direct connection string for DDL migrations only
DIRECT_DATABASE_URL=postgresql://user:password@ep-sample.us-east-1.aws.neon.tech/mi_tienda?sslmode=require
DB_SSL=true

# Immutable SuperAdmin Master Account (Protected by DB Trigger)
SUPERADMIN_EMAIL=admin@tutienda.com

# Authentication & Session Secrets
JWT_SECRET=generate_a_random_64_char_secret_for_jwt_auth_signing_here
JWT_REFRESH_SECRET=generate_another_random_64_char_secret_for_refresh_tokens_here
JWT_EXPIRES_IN=15m

# Mercado Pago Integration (Checkout Pro + Webhooks HMAC)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-0000000000000000-000000-00000000000000000000000000000000-000000000
MERCADOPAGO_PUBLIC_KEY=APP_USR-00000000-0000-0000-0000-000000000000
MERCADOPAGO_WEBHOOK_SECRET=your_mercadopago_webhook_secret_key_here

# Cloudinary Storage (Free Tier)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_key

# ARCA (ex-AFIP) Electronic Invoicing Web Services (WSAA & WSFEv1)
ARCA_CUIT_EMISOR=20123456789
ARCA_PUNTO_VENTA=1
ARCA_ENV=homologacion
ARCA_WSAA_WSDL_URL=https://wsaahomo.afip.gov.ar/ws/services/LoginCms?wsdl
ARCA_WSFE_WSDL_URL=https://wswhomo.afip.gov.ar/wsfev1/service.asmx?WSDL
ARCA_CERT_X509=-----BEGIN CERTIFICATE-----
...
-----END CERTIFICATE-----
ARCA_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----
...
-----END RSA PRIVATE KEY-----
ARCA_KMS_MASTER_KEY=32_byte_hex_key_for_envelope_encryption_of_fiscal_certs_here

# Resilience & Keep-Alive Daemon
ENABLE_KEEP_ALIVE_DAEMON=true
